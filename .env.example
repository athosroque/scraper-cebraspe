# PostgreSQL — instância study-rag-db (study-rag-agent), rede homelab_default
# Fora de container: host localhost, porta 5434
# Dentro da rede homelab_default: host study-rag-db, porta 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=study_rag
POSTGRES_USER=
POSTGRES_PASSWORD=

# LiteLLM Gateway (llm-gateway) — modelo glm-5.3-flash
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=
