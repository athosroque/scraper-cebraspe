# PostgreSQL próprio do projeto — serviço scraper-cebraspe-db (docker-compose.yml, ADR-026)
# Fora de container: host localhost, porta 5435
# Dentro da rede homelab_default: host scraper-cebraspe-db, porta 5432
# POSTGRES_DB/USER/PASSWORD também inicializam o container na 1ª subida.
# Gerar senha: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=cebraspe
POSTGRES_USER=cebraspe
POSTGRES_PASSWORD=


# Telegram Bot & IA
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# OpenRouter & Langfuse (Extração de Taxonomia) — monitoramento centralizado no Langfuse;
# chave própria por tarefa/modelo no OpenRouter, cada uma mapeada a um projeto Langfuse diferente.
# O SDK oficial do Langfuse (OTel, ADR-023) consome essas mesmas variáveis de ambiente.
# Chaves do OpenRouter por etapa (nome da chave no OpenRouter = nome do trace no Langfuse).
# Vazia -> cai na OPENROUTER_API_KEY abaixo (com aviso no log).
# cebraspe-4-taxonomia-edital (Fase 4)
OPENROUTER_KEY_TAXONOMIA_EDITAL=
# cebraspe-5b-sinonimos (Etapa 5B)
OPENROUTER_KEY_SINONIMOS=
# cebraspe-5b2-curadoria-arvore (Etapa 5B.2)
OPENROUTER_KEY_CURADORIA_ARVORE=
# cebraspe-5d-classificacao-questoes (Etapa 5D)
OPENROUTER_KEY_CLASSIFICACAO_QUESTOES=
# cebraspe-telegram-bot (bot do Telegram)
OPENROUTER_KEY_TELEGRAM=
# Fallback geral
OPENROUTER_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# Site de Questões — credenciais por role (ADR-033)
SITE_DB_LEITURA_USER=site_leitura
SITE_DB_LEITURA_PASSWORD=
SITE_DB_APP_USER=site_app
SITE_DB_APP_PASSWORD=

# Site (5F.3): Google OAuth e sessão. SESSION_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# true em produção (HTTPS via Tunnel)
SESSION_HTTPS_ONLY=false

# Jira Kanban (scripts/jira_sync.py na raiz do portfólio lê este .env por padrão)
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://athoslobin.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
