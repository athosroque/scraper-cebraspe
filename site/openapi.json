{
  "openapi": "3.1.0",
  "info": {
    "title": "Questões CEBRASPE",
    "description": "API de leitura do site público de questões CEBRASPE (piloto 2025). Fonte das questões: CEBRASPE (cebraspe.org.br). Ver ADR-033.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/questoes": {
      "get": {
        "tags": [
          "Questões"
        ],
        "summary": "Lista questões objetivas com filtros",
        "description": "Uma entrada por questão (cargos e nós agregados), ordenada por concurso, caderno e número. Os filtros combinam com E. Sem filtro, devolve as 2.800 questões objetivas do piloto 2025.",
        "operationId": "listar_questoes_api_v1_questoes_get",
        "parameters": [
          {
            "name": "banca",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Banca (ex.: `CEBRASPE`).",
              "title": "Banca"
            },
            "description": "Banca (ex.: `CEBRASPE`)."
          },
          {
            "name": "orgao",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Órgão (ex.: `PF`, `STM`). Valores em `/facetas`.",
              "title": "Orgao"
            },
            "description": "Órgão (ex.: `PF`, `STM`). Valores em `/facetas`."
          },
          {
            "name": "ano",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ano do concurso (ex.: `2025`).",
              "title": "Ano"
            },
            "description": "Ano do concurso (ex.: `2025`)."
          },
          {
            "name": "concurso",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Slug do concurso (ex.: `PF_25_ADM`).",
              "title": "Concurso"
            },
            "description": "Slug do concurso (ex.: `PF_25_ADM`)."
          },
          {
            "name": "cargo_numero",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Número do cargo no edital. Use junto com `concurso`.",
              "title": "Cargo Numero"
            },
            "description": "Número do cargo no edital. Use junto com `concurso`."
          },
          {
            "name": "nivel",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`superior` ou `medio`.",
              "title": "Nivel"
            },
            "description": "`superior` ou `medio`."
          },
          {
            "name": "tipo_conhecimento",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`basico` ou `especifico`.",
              "title": "Tipo Conhecimento"
            },
            "description": "`basico` ou `especifico`."
          },
          {
            "name": "no_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nó da árvore (`/arvore`). Matéria ou assunto incluem as questões dos descendentes.",
              "examples": [
                "S-c33faee4a4"
              ],
              "title": "No Id"
            },
            "description": "Nó da árvore (`/arvore`). Matéria ou assunto incluem as questões dos descendentes."
          },
          {
            "name": "anuladas",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "incluir",
                "excluir",
                "so"
              ],
              "type": "string",
              "description": "Tratamento das questões anuladas.",
              "default": "incluir",
              "title": "Anuladas"
            },
            "description": "Tratamento das questões anuladas."
          },
          {
            "name": "fora_do_edital",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "todos",
                "sim",
                "nao"
              ],
              "type": "string",
              "description": "`sim`: só questões classificadas fora do edital do cargo; `nao`: só dentro.",
              "default": "todos",
              "title": "Fora Do Edital"
            },
            "description": "`sim`: só questões classificadas fora do edital do cargo; `nao`: só dentro."
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Página, a partir de 1.",
              "default": 1,
              "title": "Pagina"
            },
            "description": "Página, a partir de 1."
          },
          {
            "name": "tamanho_pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Itens por página (máx. 50).",
              "default": 20,
              "title": "Tamanho Pagina"
            },
            "description": "Itens por página (máx. 50)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaQuestoes"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/questoes/{chave}": {
      "get": {
        "tags": [
          "Questões"
        ],
        "summary": "Detalhe de uma questão",
        "description": "Busca pela chave estável `concurso|caderno|numero`.",
        "operationId": "obter_questao_api_v1_questoes__chave__get",
        "parameters": [
          {
            "name": "chave",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chave"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestaoDetalhe"
                }
              }
            }
          },
          "404": {
            "description": "Questão não encontrada"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/arvore": {
      "get": {
        "tags": [
          "Árvore"
        ],
        "summary": "Árvore mestre com contagem de questões",
        "description": "Matéria → assunto → subassunto. A contagem é de questões distintas e sobe a árvore.",
        "operationId": "obter_arvore_api_v1_arvore_get",
        "parameters": [
          {
            "name": "apenas_com_questoes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Omite nós sem nenhuma questão.",
              "default": true,
              "title": "Apenas Com Questoes"
            },
            "description": "Omite nós sem nenhuma questão."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NoArvore"
                  },
                  "title": "Response Obter Arvore Api V1 Arvore Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/facetas": {
      "get": {
        "tags": [
          "Facetas"
        ],
        "summary": "Valores possíveis dos filtros",
        "description": "Cada valor vem com o total de questões distintas, para montar os filtros da interface.",
        "operationId": "obter_facetas_api_v1_facetas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacetasResponse"
                }
              }
            }
          }
        }
      }
    },
    "/saude": {
      "get": {
        "tags": [
          "Infra"
        ],
        "summary": "Checagem de saúde (banco de leitura)",
        "operationId": "saude_saude_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
