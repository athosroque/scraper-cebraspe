# Imagem do site (serviço scraper-cebraspe-site do docker-compose.yml).
# Ambiente dev: o código vem por bind mount de ./site (uvicorn --reload).
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.115.0" "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.6.0" "pydantic-settings>=2.2" "jinja2>=3.1.2" \
    "python-multipart>=0.0.9" "authlib>=1.3" "itsdangerous>=2.1" \
    "httpx>=0.27.0" "psycopg2-binary>=2.9.9" "python-dotenv>=1.0.1"
RUN useradd --create-home --uid 1000 site
USER site
ENV PYTHONUNBUFFERED=1
WORKDIR /app/site
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*", "--reload"]
